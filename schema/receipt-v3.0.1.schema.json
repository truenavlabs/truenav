{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truenav:receipt:v3.0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_version": {
      "const": "3"
    },
    "method_version": {
      "const": "truenav-v3.0.1"
    },
    "method_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "network": {
      "const": "near_testnet"
    },
    "receipts_contract": {
      "const": "receipts.tnlab-718ca9.testnet"
    },
    "currency": {
      "const": "USD"
    },
    "engine_version_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine_code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "fund_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "fund_account": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}[a-z0-9]$"
    },
    "kind": {
      "const": "credit"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical u64; semantic validator rejects >18446744073709551615."
    },
    "prev_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_seq": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Canonical u64; semantic validator rejects >18446744073709551615."
        },
        {
          "type": "null"
        }
      ]
    },
    "correction_reason_code": {
