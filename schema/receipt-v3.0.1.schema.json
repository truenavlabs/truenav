          },
          "key_id": {
            "type": "string",
            "pattern": "^(servicer|bank|fund_admin|custodian):[a-z0-9][a-z0-9_-]{0,31}:v[1-9][0-9]{0,8}$"
          },
          "sig_ok": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "key_id",
          "sig_ok"
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "source": {
                "const": "servicer"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "source": {
                "const": "bank"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "source": {
                "const": "fund_admin"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "source": {
                "const": "custodian"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      ]
    },
