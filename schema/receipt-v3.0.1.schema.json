        "nav_report": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pledge_detail": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_state_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "full_report": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reported_nav": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trueval": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truerange_low": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truerange_high": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "score_x100": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parts_x100": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_score": {
