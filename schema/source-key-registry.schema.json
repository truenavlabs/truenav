{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "const": "truenav-src-v1"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^(servicer|bank|fund_admin|custodian):[a-z0-9][a-z0-9_-]{0,31}:v[1-9][0-9]{0,8}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "servicer",
              "bank",
              "fund_admin",
              "custodian"
            ]
          },
          "fund_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "public_key": {
            "type": "string",
            "pattern": "^ed25519:[0-9a-f]{64}$"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "key_id",
          "role",
          "fund_scope",
          "public_key",
          "valid_from",
          "valid_until",
          "revoked"
        ]
      }
    }
  },
  "required": [
    "registry_version",
    "keys"
  ]
}
